---
/**
 * Today's session: one short, mixed session of what's due for you (src/lib/today.ts plans it, src/client/today.ts
 * runs it). With ?topic=<exam topic id> it drills one exam topic's questions instead (from the Mastery page).
 */
import Base from "../layouts/Base.astro";
import GoalCard from "../components/GoalCard.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import { EXAM_TOPICS } from "../lib/mastery";
import { withBase } from "../lib/routes";
import { studyIndexJson } from "../lib/studyIndex";

const base = import.meta.env.BASE_URL;
---
<Base title="Today's session" nav="today" description="A short daily session of flashcards and questions, picked for you">
  <div class="page page--read today" data-today data-cards={withBase(base, "interview.json")} data-questions={withBase(base, "mcq.json")}>
    <script is:inline type="application/json" data-study-index set:html={studyIndexJson(base)} />
    <script is:inline type="application/json" data-exam-topics set:html={JSON.stringify(EXAM_TOPICS)} />
    <PageHead eyebrow="Daily practice" title="Today's session" sub="About 10 minutes of what you need most today: flashcards that are due, questions you got wrong before, and questions from your weakest lessons, mixed together." />

    <GoalCard />

    <section class="card today__start" data-today-start aria-labelledby="td-h">
      <h2 id="td-h" data-today-title>Your session</h2>
      <p class="muted" data-today-summary>Loading…</p>
      <ul class="today__parts" data-today-parts hidden></ul>
      <div class="btn-row">
        <button class="btn btn--primary btn--lg" type="button" data-today-go hidden><Icon name="zap" /> <span data-text>Start session</span></button>
      </div>
      <div class="today__empty" data-today-empty hidden>
        <p><b>You're all caught up.</b> Nothing is due right now.</p>
        <div class="btn-row">
          <a class="btn btn--sm btn--primary" href="#" data-today-next hidden>Next lesson</a>
          <a class="btn btn--sm" href={withBase(base, "mcq/")}>Take an MCQ test</a>
          <a class="btn btn--sm" href={withBase(base, "battle/")}>Start a quiz battle</a>
        </div>
      </div>
      <p class="account__msg" data-today-msg role="status" hidden></p>
    </section>

    <section class="card today__run" data-today-run hidden aria-labelledby="td-n">
      <div class="today__top">
        <p class="iv-live__count"><b id="td-n" data-today-n>1 of 10</b> <span class="pill" data-today-kind></span></p>
        <button class="btn btn--sm btn--ghost" type="button" data-today-stop>Stop</button>
      </div>
      <div class="progress progress--thin" aria-hidden="true"><span data-today-bar></span></div>
      <div class="today__step" data-today-step tabindex="-1"></div>
    </section>

    <section class="card today__done" data-today-done hidden aria-labelledby="td-done-h" tabindex="-1">
      <h2 id="td-done-h"><Icon name="check" /> Session complete</h2>
      <p data-today-result></p>
      <div class="btn-row">
        <a class="btn btn--primary" href="#" data-today-after hidden></a>
        <button class="btn" type="button" data-today-again hidden>Another round</button>
        <a class="btn" href={withBase(base, "mastery/")}>See your mastery</a>
      </div>
      <p class="small app-only today__remind" data-today-remind hidden><button class="btn btn--sm" type="button"><Icon name="bell" /> Remind me every day at 7 pm</button> <span class="muted">You can change the time in Preferences.</span></p>
    </section>
  </div>
</Base>
